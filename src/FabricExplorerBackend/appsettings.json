{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FabricExplorerDatabase": "Host=postgres;Port=5432;Database=myapp;Username=postgres;Password=postgres",
    "RedisCache": "myapp-redis:6379,abortConnect=false"
  },

  "Entra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_API_CLIENT_ID"
  },

  "Azure": {
    "Scopes": {
      "Fabric": "https://api.fabric.microsoft.com/.default",
      "Storage": "https://storage.azure.com/.default",
      "Sql": "https://database.windows.net/.default"
    }
  },

  "Fabric": {
    "Api": {
      "BaseUrl": "https://api.fabric.microsoft.com/v1"
    },
    "SqlSchemas": {
      "Default": "dbo"
    }
  },

  "Api": {
    "Headers": {
      "ConnectionId": "X-Connection-Id"
    }
  },

  "Cache": {
    "KeyPrefix": "FabricExplorer",
    "WorkspaceList": "00:05:00",
    "ItemList": "00:01:00",
    "TableStats": "00:01:00",
    "MirroringDefinition": "01:00:00",
    "TableStale": "30.00:00:00",
    "SharedFetchTimeout": "00:01:00",
    "WarehouseProbeTimeout": "00:00:10"
  },

  "Catalog": {
    "TreeCache": "00:02:00",
    "TableDetailCache": "00:02:00",
    "SchemaParallelism": 4
  },

  "Authentication": {
    "TokenCacheSafetyMargin": "00:05:00"
  },

  "Query": {
    "ResultRetention": "01:00:00",
    "CommandTimeout": "00:05:00",
    "MaxConcurrentQueries": 4,
    "QueueCapacity": 100,
    "RowGroupSize": 10000,
    "MaxPartSizeBytes": 67108864,
    "MaxSqlLength": 100000,
    "DefaultPageSize": 100,
    "MaxPageSize": 1000,
    "CleanupInterval": "00:05:00",
    "CleanupBatchSize": 50
  },

  "QueryResultStorage": {
    "RootPath": "query-results"
  },

  "OperationPolling": {
    "Enabled": true,
    "TickInterval": "00:00:05",
    "BatchSize": 20,
    "LeaseDuration": "00:02:00",
    "MaxOperationAge": "06:00:00",
    "MaxConsecutivePollFailures": 5,
    "BaseBackoff": "00:00:10",
    "MaxBackoff": "00:02:00",
    "TableStatsMaxParallelism": 4
  },

  "EventStreaming": {
    "CompletedRetention": "00:02:00",
    "MaxLifetime": "00:05:00",
    "HeartbeatInterval": "00:00:15",
    "CleanupInterval": "00:00:30",
    "MaxEventsPerStream": 2000,
    "MaxActiveStreams": 1000
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}" }
      }
    ]
  }
}
