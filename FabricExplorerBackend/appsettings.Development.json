{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "FabricExplorerDatabase": "Host=postgres;Port=5432;Database=myapp;Username=postgres;Password=postgres",
    "RedisCache": "myapp-redis:6379,abortConnect=false"
  },

  "Entra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_API_CLIENT_ID"
  },

  "Azure": {
    "Scopes": {
      "Fabric": "https://api.fabric.microsoft.com/.default",
      "Storage": "https://storage.azure.com/.default",
      "Sql": "https://database.windows.net/.default"
    }
  },

  "Fabric": {
    "Api": {
      "BaseUrl": "https://api.fabric.microsoft.com/v1/"
    },
    "SqlSchemas": {
      "Default": "dbo"
    }
  },

  "Api": {
    "Headers": {
      "ConnectionId": "X-Connection-Id"
    }
  },

  "Cache": {
    "KeyPrefix": "FabricExplorer",
    "WorkspaceList": "00:05:00",
    "ItemList": "00:01:00",
    "TableStats": "00:01:00",
    "MirroringDefinition": "01:00:00",
    "TableStale": "30.00:00:00",
    "SharedFetchTimeout": "00:01:00",
    "WarehouseProbeTimeout": "00:00:10"
  },

  "Authentication": {
    "TokenCacheSafetyMargin": "00:05:00"
  },

  "OperationPolling": {
    "Enabled": true,
    "TickInterval": "00:00:05",
    "BatchSize": 20,
    "LeaseDuration": "00:02:00",
    "MaxOperationAge": "06:00:00",
    "MaxConsecutivePollFailures": 5,
    "BaseBackoff": "00:00:10",
    "MaxBackoff": "00:02:00",
    "TableStatsMaxParallelism": 4
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}